LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_TOKEN=your_line_channel_access_token
PORT=8080
BOT_CONFIG_PATH=configs/faq_seed.yaml
ENABLE_PPROF=true
EVENT_DEDUP_TTL=6h

# SQLite database path for user-to-diagnosis mapping (leave empty to disable persistence)
DB_PATH=data/users.db

# local image values (used by deploy tooling)
IMAGE_REGISTRY=ghcr.io
IMAGE_REPOSITORY=yimsoijoi/rama-chatbot
IMAGE_TAG=latest

# local domain (optional)
DOMAIN=localhost
